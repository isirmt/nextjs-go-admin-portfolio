example.com {
  log {
    output stdout
    format json
  }

  handle_errors {
    @upstream_error expression `{err.status_code} == 502 || {err.status_code} == 503 || {err.status_code} == 504`
    handle @upstream_error {
      root * /srv/maintenance
      rewrite * /index.html
      header Retry-After "60"
      file_server {
        status 503
      }
    }
  }

  @nextauth path /api/auth*
  handle @nextauth {
    reverse_proxy web:3000
  }

  @api path /api/*
  handle @api {
    uri strip_prefix /api
    reverse_proxy backend:4000
  }

  handle {
    reverse_proxy web:3000
  }
}
